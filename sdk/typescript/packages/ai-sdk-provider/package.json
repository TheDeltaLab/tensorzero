{
  "name": "@delta-ai/ai-sdk-provider",
  "version": "0.2.0",
  "description": "Vercel AI SDK provider for the TensorZero gateway, with async batch inference",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.62",
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@ai-sdk/provider": "^4.0.0",
    "@delta-ai/tensorzero-sdk": "workspace:*"
  },
  "peerDependencies": {
    "ai": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "ai": "^7.0.93",
    "tsup": "^8.3.5",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheDeltaLab/tensorzero",
    "directory": "sdk/typescript/packages/ai-sdk-provider"
  },
  "homepage": "https://github.com/TheDeltaLab/tensorzero/tree/main/sdk/typescript/packages/ai-sdk-provider"
}
