{
  "name": "@delta-ai/tensorzero-sdk",
  "version": "0.2.1",
  "description": "TypeScript client for the TensorZero gateway async inference API",
  "homepage": "https://github.com/TheDeltaLab/tensorzero/tree/main/sdk/typescript/packages/tensorzero-sdk",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheDeltaLab/tensorzero",
    "directory": "sdk/typescript/packages/tensorzero-sdk"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
